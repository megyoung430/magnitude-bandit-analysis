# Copy to .env (git-ignored) and set for this machine.
# Directory containing the experiment folders, e.g. 3x3_field_magnitude_bandit/
BANDIT_DATA_ROOT=/Volumes/behrens/meg
# Optional: where cached imports are stored (default: <repo>/.cache)
# BANDIT_CACHE_DIR=/path/to/cache
# Optional: Notion integration token for `scripts/build_code_map.py --notion` (never commit it)
# NOTION_TOKEN=ntn_...
